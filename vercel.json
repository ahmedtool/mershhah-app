{
  "installCommand": "npm install -g pnpm@10.26.1 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/mershhah run build",
  "outputDirectory": "artifacts/mershhah/dist/public",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://smmriycsboexindabanc.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
